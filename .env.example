# ── Backend ────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically from the PostgreSQL addon.
# Format: postgresql://user:pass@host:port/dbname
# (App transforms it to postgresql+asyncpg:// automatically)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Set to true if Railway PostgreSQL requires SSL
DATABASE_SSL=false

# Allowed CORS origins — comma-separated list of frontend URLs
CORS_ORIGINS=https://your-frontend.up.railway.app
# Extra origin regex (default allows any *.up.railway.app); set empty to disable
# CORS_ORIGIN_REGEX=

# Data retention in days (0 = keep forever)
RETENTION_DAYS_ARTICLES=30
RETENTION_DAYS_OSINT=30
RETENTION_DAYS_SOCIAL=14

# docker-compose only: Postgres password for the bundled db service
POSTGRES_PASSWORD=change-me

# Optional: Reddit OAuth (social tab)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=WarRoom/1.0

# Optional: free security-feed keys (sources are skipped or throttled without them)
# NVD: nvd.nist.gov/developers/request-an-api-key (10x rate limit)
NVD_API_KEY=
# abuse.ch: auth.abuse.ch (enables URLhaus + MalwareBazaar)
ABUSECH_AUTH_KEY=
# AlienVault OTX: otx.alienvault.com → Settings (enables threat pulses)
OTX_API_KEY=

# Optional: paid API keys
GUARDIAN_API_KEY=
NEWSDATA_API_KEY=
ALPHA_VANTAGE_KEY=

# Railway sets PORT automatically — the port uvicorn binds to
PORT=8000


# ── Frontend ────────────────────────────────────────────────────
# VITE_API_URL: public backend URL, baked in at build time (Docker build arg)
VITE_API_URL=https://your-backend.up.railway.app

# PORT: Railway injects this — nginx listens on it
PORT=80

# BACKEND_URL: Private network URL of the backend service
BACKEND_URL=http://backend.railway.internal:8000

# ── Akamai / self-hosted (deploy/akamai/docker-compose.prod.yml) ─
# DOMAIN=warroom.example.com
# ACME_EMAIL=ops@example.com
